# App registration (permissoes de aplicativo) — usadas pelo proxy local (vite.config.js).
# Copie este arquivo para .env e preencha. NUNCA commite o .env (ja ignorado no .gitignore).
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Site SharePoint onde ficam as listas. Nao e segredo; exposto ao client (prefixo VITE_).
VITE_SITE_ID=
