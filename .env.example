# Conexao Databricks — usada SO pelo proxy local (vite.config.js), nunca pelo browser.
# Copie este arquivo para .env e preencha. NUNCA commite o .env (ja ignorado no .gitignore).

# Workspace do Databricks, ex.: https://<workspace-id>.azuredatabricks.net
DATABRICKS_HOST=

# Personal Access Token (PAT) do Databricks. SEGREDO — fica so no servidor/proxy.
DATABRICKS_TOKEN=

# ID do SQL Warehouse que executa as queries.
DATABRICKS_WAREHOUSE_ID=

# Catalog e schema padrao (Unity Catalog) onde estao as tabelas. O proxy os injeta em cada
# statement, entao os data/*.js usam o nome simples da tabela (ex.: recorrencias_reuniao).
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
